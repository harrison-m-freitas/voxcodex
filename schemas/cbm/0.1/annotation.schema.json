{
  "additionalProperties": false,
  "properties": {
    "annotation_type": {
      "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$",
      "title": "Annotation Type",
      "type": "string"
    },
    "confidence_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Confidence Ref"
    },
    "epistemic_status": {
      "enum": [
        "explicit",
        "derived",
        "inferred",
        "human_asserted"
