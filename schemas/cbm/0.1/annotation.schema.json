    },
    "evidence_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Evidence Refs",
      "type": "array"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "provenance_ref": {
      "title": "Provenance Ref",
      "type": "string"
    },
    "target_ref": {
      "title": "Target Ref",
      "type": "string"
    },
    "value": {
      "additionalProperties": true,
      "title": "Value",
      "type": "object"
    }
  },
  "required": [
    "id",
    "target_ref",
    "annotation_type",
    "value",
    "epistemic_status",
    "provenance_ref"
