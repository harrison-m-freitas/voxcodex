      "properties": {
        "dimension": {
          "enum": [
            "lexical",
            "character",
            "structure",
            "symbolic",
            "ordering"
          ],
          "title": "Dimension",
          "type": "string"
        },
        "requirement": {
          "const": "preserve_exactly",
          "default": "preserve_exactly",
          "title": "Requirement",
          "type": "string"
        }
      },
      "required": [
        "dimension"
      ],
      "title": "FidelityConstraint",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "child_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Child Refs",
      "type": "array"
    },
    "content_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Content Refs",
      "type": "array"
    },
    "fidelity_constraints": {
      "default": [],
      "items": {
        "$ref": "#/$defs/FidelityConstraint"
      },
