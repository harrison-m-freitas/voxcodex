    },
    "provenance_ref": {
      "title": "Provenance Ref",
      "type": "string"
    },
    "role": {
      "pattern": "^[A-Za-z0-9_]+(?:\\.[A-Za-z0-9_]+)+$",
      "title": "Role",
      "type": "string"
    },
    "source_anchor_refs": {
      "default": [],
      "items": {
        "type": "string"
      },
      "title": "Source Anchor Refs",
      "type": "array"
    },
    "structured_payload_ref": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Structured Payload Ref"
    }
  },
  "required": [
    "id",
    "order_key",
    "node_class",
    "role",
    "provenance_ref"
