from pydantic import BaseModel
import pytest

from voxcodex.digests import canonical_json_bytes, semantic_digest, sha256_bytes


def test_canonical_json_ignores_mapping_order():
    assert canonical_json_bytes({"b": 2, "a": 1}) == canonical_json_bytes({"a": 1, "b": 2})


def test_sha256_is_lowercase_hex():
    assert sha256_bytes(b"abc") == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad"


class ExampleModel(BaseModel):
    kept: str
    omitted: str | None = None


def test_semantic_digest_honors_exclusions_and_none():
    left = ExampleModel(kept="same", omitted="left")
    right = ExampleModel(kept="same", omitted="right")
    assert semantic_digest(left, exclude={"omitted"}) == semantic_digest(right, exclude={"omitted"})


try:
    from hypothesis import given, strategies as st
except ModuleNotFoundError:
    given = None
    st = None


@pytest.mark.skipif(given is None, reason="Hypothesis is unavailable in this sandbox")
def test_canonical_json_is_stable_for_reversed_items():
    # The actual property test is defined dynamically so collection remains possible
    # in restricted environments that cannot install the dev dependency.
    @given(st.dictionaries(st.text(min_size=1), st.integers(), max_size=20))
    def property_test(mapping):
        reversed_mapping = dict(reversed(list(mapping.items())))
        assert canonical_json_bytes(mapping) == canonical_json_bytes(reversed_mapping)

    property_test()
